{
  "name": "steamos-orphan",
  "version": "1.0.1",
  "description": "SteamOS Decky plugin to detect and manage orphaned folders in Steam library common directories.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "pnpm run build && python3 build_zip.py",
    "test": "python3 tests/test_scanner.py && python3 tests/test_cross_drive.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "steamos",
    "steam-deck",
    "storage",
    "cleaner",
    "orphan"
  ],
  "author": "David Lockwood",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
